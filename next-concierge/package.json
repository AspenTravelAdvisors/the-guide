    "build:hotel-points": "node scripts/build-hotel-points.mjs",
    "build:journey-facts": "node scripts/build-journey-facts.mjs",
    "verify:journey-facts": "node scripts/build-journey-facts.mjs --check",
    "build:collection-counts": "node scripts/build-collection-counts.mjs",
    "verify:collection-counts": "node scripts/build-collection-counts.mjs --check",
    "build:safari-camps": "node scripts/build-safari-camps.mjs",
    "verify:safari-camps": "node scripts/build-safari-camps.mjs --check",
    "build:gateway-hotels": "node scripts/build-gateway-hotels.mjs",
    "verify:gateway-hotels": "node scripts/build-gateway-hotels.mjs --check && node scripts/verify-gateway-hotels.mjs",
    "build:sea-routes": "node scripts/build-sea-routes.mjs",
    "build:landmask": "node scripts/build-landmask.mjs",
    "build:cruise-regions": "node scripts/build-cruise-regions.mjs",
    "verify:cruise-regions": "node scripts/build-cruise-regions.mjs --check",
    "verify:atlas-regions": "node scripts/verify-atlas-regions.mjs",
    "verify:sea-routes": "node scripts/verify-sea-routes.mjs",
    "verify:landmask": "node scripts/verify-landmask.mjs",
    "verify:adapters": "node scripts/verify-adapters.mjs",
    "harvest:expedition-ships": "node scripts/harvest-expedition-ships.mjs",
    "harvest:journey-photos": "node scripts/harvest-journey-photos.mjs",
    "build:expedition-ships": "node scripts/build-expedition-ships.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "verify:deeplinks": "node scripts/verify-deeplinks.mjs",
    "verify:hotels": "node scripts/verify-hotels.mjs",
    "verify:villas": "node scripts/verify-villas.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:bail": "node scripts/verify-all.mjs --bail",
    "verify:offering-shape": "node scripts/verify-offering-shape.mjs",
    "verify:intents": "node scripts/verify-intents.mjs",
    "verify:layer-order": "node scripts/verify-layer-order.mjs",
    "verify:legend-focus": "node scripts/verify-legend-focus.mjs",
    "verify:ambient-tour": "node scripts/verify-ambient-tour.mjs",
    "verify:atlas-handoff": "node scripts/verify-atlas-handoff.mjs",
    "verify:route-order": "node scripts/verify-route-order.mjs",
    "verify:route-flight": "node scripts/verify-route-flight.mjs",
    "verify:atlas-ui": "node scripts/verify-atlas-ui.mjs",
    "audit:ports": "node scripts/audit-port-locations.mjs",
    "fix:ports": "node scripts/fix-port-locations.mjs",
    "place:waters": "node scripts/place-named-waters.mjs",
    "verify:waters": "node scripts/place-named-waters.mjs --check",
    "verify:ports": "node scripts/fix-port-locations.mjs --check && node scripts/audit-port-locations.mjs --strict",
    "verify:photoreal": "node scripts/verify-photoreal.mjs",
    "verify:flyover": "node --no-warnings scripts/verify-flyover.mjs",
    "build:flyover-framing": "node --no-warnings scripts/build-flyover-framing.mjs",
    "sync:virtuoso-hotels": "node scripts/sync-virtuoso-hotels.mjs",
    "match:virtuoso-hotels": "node scripts/match-virtuoso-hotels.mjs",
    "merge:virtuoso-hotels": "node scripts/merge-virtuoso-hotels.mjs",
    "sync:villas": "node scripts/sync-villas.mjs",
    "sync:virtuoso": "npm run sync:virtuoso-hotels && npm run sync:virtuoso-promotions && npm run sync:virtuoso-cruises && npm run sync:virtuoso-tours && npm run match:virtuoso-hotels && npm run build:atlas",
    "verify:virtuoso": "node scripts/verify-virtuoso-freshness.mjs && node scripts/merge-virtuoso-hotels.mjs --check && node scripts/merge-virtuoso-journeys.mjs --check",
    "sync:virtuoso-promotions": "node scripts/sync-virtuoso-promotions.mjs",
    "sync:virtuoso-cruises": "node scripts/sync-virtuoso-cruises.mjs",
    "sync:virtuoso-tours": "node scripts/sync-virtuoso-tours.mjs",
    "merge:virtuoso-journeys": "node scripts/merge-virtuoso-journeys.mjs",
    "audit:listings": "node scripts/audit-listings.mjs",
    "verify:listings": "node scripts/audit-listings.mjs --strict",
    "audit:curated-jet": "node scripts/audit-curated-jet.mjs",
    "verify:curated-jet": "node scripts/audit-curated-jet.mjs --strict",
    "verify:fit-binding": "node scripts/verify-fit-binding.mjs",
    "verify:guide-budget": "node scripts/verify-guide-budget.mjs",
    "verify:seo": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@vercel/analytics": "^2.0.1",
    "botid": "^1.5.11",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0"
  }
}
